# Everything is optional. With no variables set, KeepWarm runs fully offline:
# embedded Postgres (PGlite in ./.pglite), rule-based extraction, emails printed to the console, no passcode.
# Copy to .env.local and fill in what you want to turn on.

# --- Database -----------------------------------------------------------
# Neon (or any Postgres) connection string. When set, PGlite is not used.
# Run `npm run db:migrate` then `npm run seed` (demo data) once after setting it.
DATABASE_URL=

# --- AI extraction ------------------------------------------------------
# When set, messages are read by Claude; otherwise by the built-in rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Email (emergency alerts + morning digest) --------------------------
RESEND_API_KEY=
ALERT_EMAIL_TO=denise@example.com
ALERT_EMAIL_FROM="KeepWarm <alerts@yourdomain.com>"
# Public URL of the app, used for links in emails
APP_URL=https://keepwarm.vercel.app

# --- Access -------------------------------------------------------------
# Shared passcode for Denise (and her husband). Unset = no login.
APP_PASSCODE=
# Webhooks (/api/inbound/email|sms|call) require ?token=<this>. Unset = no check (local only).
INBOUND_TOKEN=
# Vercel Cron sends this as a Bearer token to /api/cron/digest.
CRON_SECRET=

# --- Business -----------------------------------------------------------
# Denise's location wasn't mentioned on the call; Central time is an assumption.
BUSINESS_TZ=America/Chicago
OWNER_NAME=Denise
BUSINESS_NAME="Denise's Refrigeration"
